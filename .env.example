# ── OWID Data Tools — MCP server configuration ────────────────────────────────
# Copy this file to `.env` (or export these variables) and adjust as needed.

# Public HTTPS base URL of your deployed server (no trailing slash).
# Required for OAuth (claude.ai) and used to build REST endpoint links.
PUBLIC_URL=https://your-app.example.com

# Where to serve the MCP endpoint. Add "{PUBLIC_URL}/mcp" in Gemini or Claude.
MCP_PATH=/mcp

# Host/port to bind.
HOST=0.0.0.0
PORT=8000

# Authentication mode:
#   none     -> no auth (default; fine for local/private tunnels, e.g. Tailscale)
#   api_key  -> static bearer token (works with Gemini "API key" auth)
#   oauth    -> OAuth 2.1 with dynamic client registration (required by claude.ai)
MCP_AUTH=none

# Only needed when MCP_AUTH=api_key. Clients send this as the bearer token.
MCP_API_KEY=change-me

# Response limits.
MAX_TABLE_ROWS=20
MAX_SEARCH_RESULTS=5
